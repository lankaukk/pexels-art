# the piece lives at /notapipe; the site's root (mckayla.com, for now) sends
# visitors there. Files under /notapipe are served from the site's root, and
# any other /notapipe address falls back to the app.
/              /notapipe       301!
/notapipe      /index.html     200
/notapipe/*    /:splat         200

# the balcony pigeon family tree is a plain page in public/pigeons, shown at
# /pigeons without a trailing slash (/pigeons/ works too); its images use full
# /pigeons/img/ paths, so either address finds them
/pigeons       /pigeons/index.html   200!
